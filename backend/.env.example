# ==============================================================================
# FieldOps Backend Environment Configuration Template
# Copy this file to `.env` and fill in the values for your environment.
# DO NOT commit the `.env` file containing real credentials to version control.
# ==============================================================================

# Application Server Port
PORT=4000

# Environment Mode: development | production | test
NODE_ENV=development

# Frontend Client URL (used for CORS whitelist and OAuth redirects)
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Connection String (Prisma ORM)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fieldops_db?schema=public

# JWT Authentication Secret and Token Expiration
JWT_SECRET=change_me_to_a_secure_random_secret_string
JWT_EXPIRES_IN=7d

# Initial SuperAdmin Seed Account (used by prisma/seed.ts)
SUPERADMIN_EMAIL=admin@fieldops.local
SUPERADMIN_PASSWORD=AdminPassword@123!
SUPERADMIN_NAME="System SuperAdmin"

# Google OAuth 2.0 Credentials (Optional: required for Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# SMTP Mailer Configuration (Nodemailer - used for sending invite temporary passwords)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM="FieldOps Operations <no-reply@fieldops.local>"
